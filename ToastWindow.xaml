<Window x:Class="HomeworkMemo.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="300" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Loaded="Window_Loaded">
    <Border CornerRadius="10" Background="#F02A3B55" BorderBrush="#3DFFFFFF" BorderThickness="1" Padding="14"
            MouseLeftButtonUp="Window_MouseLeftButtonUp">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontWeight="Bold" FontSize="14" Foreground="White" TextWrapping="Wrap"/>
            <TextBlock x:Name="BodyText" FontSize="12" Foreground="#CCFFFFFF" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>
