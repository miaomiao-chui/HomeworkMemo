<Window x:Class="HomeworkMemo.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow"
        Background="#FF1A2233">
    <StackPanel Margin="18">
        <TextBlock Text="附件存放位置" Foreground="#B0FFFFFF" FontSize="12"/>
        <Grid Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="RootBox" Grid.Column="0" Padding="6" Background="#28FFFFFF" Foreground="White" BorderBrush="#3DFFFFFF" BorderThickness="1" VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Content="浏览..." Margin="8,0,0,0" Width="80" Click="Browse_Click"/>
        </Grid>
        <CheckBox x:Name="MigrateBox" Content="迁移现有附件到新位置" Foreground="#CCFFFFFF" IsChecked="True" Margin="0,4,0,10"/>

        <CheckBox x:Name="NotifyBox" Content="开启截止提醒" Foreground="#CCFFFFFF" IsChecked="True" Margin="0,0,0,6"/>
        <CheckBox x:Name="AutoStartBox" Content="开机自启" Foreground="#CCFFFFFF" IsChecked="False" Margin="0,0,0,6"/>

        <TextBlock Text="窗口不透明度" Foreground="#B0FFFFFF" FontSize="12"/>
        <Slider x:Name="OpacitySlider" Minimum="0.5" Maximum="1.0" Value="0.92" Margin="0,4,0,12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="取消" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="保存" Width="80" Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
