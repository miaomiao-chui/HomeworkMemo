<Window x:Class="HomeworkMemo.NoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文字附件"
        Width="380" SizeToContent="Height"
        MaxHeight="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow"
        Background="#FF1A2233">
    <StackPanel Margin="18">
        <TextBlock Text="笔记内容" Foreground="#B0FFFFFF" FontSize="12"/>
        <TextBox x:Name="NoteBox" Margin="0,6,0,12" Padding="6" MinHeight="120" MaxHeight="360"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Background="#28FFFFFF" Foreground="White" BorderBrush="#3DFFFFFF" BorderThickness="1"
                 VerticalContentAlignment="Top"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="保存" Width="80" Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
