<Window x:Class="HomeworkMemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="不拖延记事本"
        Width="340" Height="500"
        MinWidth="280" MinHeight="260"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Loaded="Window_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid>
    <Border CornerRadius="14" Background="#F01A2233" BorderBrush="#3DFFFFFF" BorderThickness="1">
        <DockPanel Margin="14">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown"
                  MouseMove="Header_MouseMove"
                  MouseLeftButtonUp="Header_MouseLeftButtonUp">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="📚 不拖延记事本" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="＋" Width="26" Height="26" Margin="0,0,4,0" Cursor="Hand" ToolTip="新增作业" Click="Add_Click"/>
                    <Button x:Name="PinButton" Content="📌" Width="26" Height="26" Margin="0,0,4,0" Cursor="Hand" ToolTip="固定置顶" Click="Pin_Click"/>
                    <Button Content="⚙" Width="26" Height="26" Margin="0,0,4,0" Cursor="Hand" ToolTip="设置" Click="Settings_Click"/>
                    <Button Content="—" Width="26" Height="26" Margin="0,0,4,0" Cursor="Hand" ToolTip="最小化" Click="Minimize_Click"/>
                    <Button Content="×" Width="26" Height="26" Cursor="Hand" ToolTip="关闭到托盘" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock x:Name="SummaryText" FontSize="12" Foreground="#8FFFFFFF"/>
                    <TextBlock Text="拖文件到卡片加附件 · 📝 加文字笔记" FontSize="11" Foreground="#66FFFFFF" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="TaskList" ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#28FFFFFF" CornerRadius="10" Padding="10" Margin="0,0,0,8"
                                    AllowDrop="True" DragOver="Item_DragOver" Drop="Item_Drop">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,8,0" ToolTip="标记完成"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="14" Foreground="White" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                            <Setter Property="Opacity" Value="0.45"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Course}" FontSize="12" Foreground="#8FD0F5" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding HasCourse, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding DeadlineText}" FontSize="12" Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#B0FFFFFF"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Urgency}" Value="overdue">
                                                            <Setter Property="Foreground" Value="#FF6B6B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Urgency}" Value="soon">
                                                            <Setter Property="Foreground" Value="#FFD166"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                                        <TextBlock Text="{Binding KindLabel}" Foreground="#9FC5FF" FontSize="12" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding DisplayText}" Foreground="#9FC5FF" FontSize="12" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="180"
                                                                   Cursor="Hand" ToolTip="{Binding ToolTipText}" Tag="{Binding}"
                                                                   MouseLeftButtonUp="Attachment_Open_MouseLeftButtonUp"/>
                                                        <Button Content="✕" Background="Transparent" BorderThickness="0" Padding="4,0" Margin="4,0,0,0"
                                                                Foreground="#80FFFFFF" FontSize="11" Cursor="Hand" ToolTip="移除附件"
                                                                Tag="{Binding}" Click="Attachment_Remove_Click"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Button Content="📝" Width="28" Height="28" Background="Transparent" BorderThickness="0" Foreground="#B0FFFFFF" Cursor="Hand"
                                                ToolTip="添加文字附件" Tag="{Binding}" Click="AddNote_Click"/>
                                        <Button Content="✏" Width="28" Height="28" Margin="0,4,0,0" Background="Transparent" BorderThickness="0" Foreground="#B0FFFFFF" Cursor="Hand"
                                                ToolTip="编辑" Tag="{Binding}" Click="Edit_Click"/>
                                        <Button Content="🗑" Width="28" Height="28" Margin="0,4,0,0" Background="Transparent" BorderThickness="0" Foreground="#B0FFFFFF" Cursor="Hand"
                                                ToolTip="删除" Tag="{Binding}" Click="Delete_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
    <Thumb x:Name="ResizeGrip" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6"
           Cursor="SizeNWSE" Opacity="0.55" DragDelta="ResizeGrip_DragDelta">
        <Thumb.Template>
            <ControlTemplate TargetType="Thumb">
                <TextBlock Text="◢" Foreground="#80FFFFFF" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
            </ControlTemplate>
        </Thumb.Template>
    </Thumb>
    </Grid>
</Window>
