<Window x:Class="HomeworkMemo.EditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑作业"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow"
        Background="#FF1A2233">
    <StackPanel Margin="18">
        <TextBlock Text="标题（选填）" Foreground="#B0FFFFFF" FontSize="12"/>
        <TextBox x:Name="TitleBox" Margin="0,4,0,12" Padding="6" Background="#28FFFFFF" Foreground="White" BorderBrush="#3DFFFFFF" BorderThickness="1"/>

        <TextBlock Text="课程（选填）" Foreground="#B0FFFFFF" FontSize="12"/>
        <TextBox x:Name="CourseBox" Margin="0,4,0,12" Padding="6" Background="#28FFFFFF" Foreground="White" BorderBrush="#3DFFFFFF" BorderThickness="1"/>

        <TextBlock Text="截止时间" Foreground="#B0FFFFFF" FontSize="12"/>
        <Grid Margin="0,4,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <DatePicker x:Name="DeadlinePicker" Grid.Column="0" VerticalAlignment="Center"/>
            <ComboBox x:Name="TimeBox" Grid.Column="2" IsEditable="True" Text="20:00" VerticalAlignment="Center">
                <ComboBoxItem Content="06:00"/>
                <ComboBoxItem Content="08:00"/>
                <ComboBoxItem Content="10:00"/>
                <ComboBoxItem Content="12:00"/>
                <ComboBoxItem Content="14:00"/>
                <ComboBoxItem Content="18:00"/>
                <ComboBoxItem Content="20:00"/>
                <ComboBoxItem Content="22:00"/>
                <ComboBoxItem Content="23:59"/>
            </ComboBox>
        </Grid>

        <TextBlock Text="提前提醒" Foreground="#B0FFFFFF" FontSize="12"/>
        <ComboBox x:Name="RemindBox" Margin="0,4,0,12">
            <ComboBoxItem Content="不提醒"/>
            <ComboBoxItem Content="提前 10 分钟"/>
            <ComboBoxItem Content="提前 30 分钟"/>
            <ComboBoxItem Content="提前 1 小时"/>
            <ComboBoxItem Content="提前 2 小时"/>
            <ComboBoxItem Content="提前 1 天"/>
        </ComboBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="取消" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="保存" Width="80" Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
